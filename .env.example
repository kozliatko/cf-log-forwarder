# Cloudflare credentials (required) - create a READ-ONLY token:
# Dashboard -> My Profile -> API Tokens -> Create Token
#   Account -> Audit Logs -> Read
#   Account -> Zero Trust -> Read   (only for zt_access)
#   Zone -> Analytics -> Read       (for security, requests, dns)
CF_API_TOKEN=your_api_token_here
CF_ACCOUNT_ID=your_account_id_here

# --- Time window ---
# Lookback window on the first run (no saved state)
DEFAULT_LOOKBACK_HOURS=24
# Records per API query / page
QUERY_LIMIT=500
# Daemon mode interval (seconds)
CF_POLL_INTERVAL=300
# Comma-separated zone IDs; empty = auto-discovery
CF_ZONE_IDS=
# Cursor state file (relative to the script directory)
STATE_FILE=cf_poller_state.json

# --- Syslog ---
# Syslog server address. If empty, messages are printed instead of sent.
SYSLOG_HOST=
SYSLOG_PORT=514
# Hostname in the syslog header (default: machine hostname)
SYSLOG_HOSTNAME=

# Syslog facility per source (16-23 = local0-local7)
FACILITY_AUDIT=17      # local1
FACILITY_ZT_ACCESS=21  # local5
FACILITY_SECURITY=18   # local2
FACILITY_REQUESTS=19   # local3
FACILITY_DNS=20        # local4

# --- Output ---
# cef | jsonl | both
OUTPUT=cef
